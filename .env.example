# ---- URL pubblico (hostname Cloudflare). Usato per manifest, link di configurazione e stream mascherati.
PUBLIC_BASE_URL=https://tv.example.com

# ---- Database (docker-compose costruisce DATABASE_URL da questa password)
POSTGRES_PASSWORD=cambiami-con-una-password-lunga
# Senza docker-compose: DATABASE_URL=postgres://utente:password@host:5432/omg
# (?sslmode=require per i database gestiti in cloud)

# ---- Amministrazione (/admin). Vuota = password generata al primo avvio e stampata nel log.
ADMIN_PASSWORD=

# ---- Segreto per firmare i cookie e cifrare i link degli stream. Vuoto = generato e salvato nel DB.
APP_SECRET=

# ---- Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=
# Con un Worker davanti (vedi cloudflare/worker.js): l'origine accetta solo richieste con questo header.
ORIGIN_SECRET=
# Proxy fidati davanti all'addon (tunnel/worker = 1)
TRUST_PROXY=1

# ---- Uscita del server (WARP)
# Tutto ciò che scarica il server passa da qui. Nel docker-compose punta al container WARP.
OUTBOUND_PROXY=http://warp:8080
# true = mai connessioni dirette: se il proxy non risponde i download falliscono
OUTBOUND_PROXY_REQUIRED=true
# Facoltativo: chiave WARP+ per il container WARP
WARP_LICENSE_KEY=

# ---- Privacy e sicurezza
STREAM_MASKING=true
STREAM_TOKEN_TTL_HOURS=12
ALLOW_LEGACY_URLS=true
# true solo se playlist/EPG/proxy sono in rete locale (192.168.x, 10.x, localhost)
ALLOW_PRIVATE_URLS=false
# Generatore playlist e resolver Python: eseguono script scaricati da URL sul server.
# Disattivati di default nei docker-compose; true per attivarli.
PYTHON_ENABLED=false
PYTHON_TIMEOUT_SEC=180
RESOLVER_TIMEOUT_SEC=30

# ---- EPG
TIMEZONE=Europe/Rome
EPG_REFRESH_HOURS=12
EPG_FUTURE_DAYS=7
ACTIVE_CONFIG_DAYS=14
