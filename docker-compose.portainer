# Stack per Portainer: addon + PostgreSQL. Imposta le variabili d'ambiente dello stack
# (POSTGRES_PASSWORD, PUBLIC_BASE_URL, ADMIN_PASSWORD) e, se usi Cloudflare Tunnel,
# aggiungi il servizio cloudflared come in docker-compose.yml.
version: '3.8'

services:
  omg-tv-stremio-addon:
    build: https://github.com/mccoy88f/OMG-Premium-TV.git#main
    image: omg-premium-tv:latest
    container_name: omg-premium-tv
    restart: unless-stopped
    environment:
      - PORT=10000
      - PUBLIC_BASE_URL=${PUBLIC_BASE_URL}
      - ADMIN_PASSWORD=${ADMIN_PASSWORD}
      - DATABASE_URL=postgres://omg:${POSTGRES_PASSWORD}@omg-db:5432/omg
      # Generatore playlist e resolver Python disattivati (PYTHON_ENABLED=true per attivarli)
      - PYTHON_ENABLED=${PYTHON_ENABLED:-false}
    volumes:
      - omg-data:/app/data
    ports:
      - "10000:10000"
    depends_on:
      - omg-db

  omg-db:
    image: postgres:16-alpine
    container_name: omg-premium-tv-db
    restart: unless-stopped
    environment:
      - POSTGRES_USER=omg
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
      - POSTGRES_DB=omg
    volumes:
      - omg-db:/var/lib/postgresql/data

volumes:
  omg-data:
  omg-db:
