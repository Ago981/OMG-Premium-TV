# Stack per Portainer: addon + PostgreSQL + Cloudflare WARP, pronto all'uso.
# Funziona senza variabili; facoltative nelle "Environment variables" dello stack:
#   ADMIN_PASSWORD, PUBLIC_BASE_URL, POSTGRES_PASSWORD, WARP_LICENSE_KEY, PYTHON_ENABLED
# Se usi Cloudflare Tunnel aggiungi il servizio cloudflared come in docker-compose.yml.

services:
  omg-tv-stremio-addon:
    build: https://github.com/mccoy88f/OMG-Premium-TV.git#main
    image: omg-premium-tv:latest
    container_name: omg-premium-tv
    restart: unless-stopped
    environment:
      - PORT=10000
      - PUBLIC_BASE_URL=${PUBLIC_BASE_URL}
      - ADMIN_PASSWORD=${ADMIN_PASSWORD}
      # Database incluso nello stack (servizio omg-db), raggiungibile solo dalla rete interna
      - DATABASE_URL=postgres://omg:${POSTGRES_PASSWORD:-omg-premium-tv}@omg-db:5432/omg
      # Generatore playlist e resolver Python disattivati (PYTHON_ENABLED=true per attivarli)
      - PYTHON_ENABLED=${PYTHON_ENABLED:-false}
      # Uscita del server da Cloudflare WARP (servizio omg-warp)
      - OUTBOUND_PROXY=${OUTBOUND_PROXY:-http://omg-warp:8080}
      - OUTBOUND_PROXY_REQUIRED=${OUTBOUND_PROXY_REQUIRED:-true}
    volumes:
      - omg-data:/app/data
    ports:
      - "10000:10000"
    depends_on:
      omg-db:
        condition: service_healthy
      omg-warp:
        condition: service_started

  omg-warp:
    build: https://github.com/mccoy88f/OMG-Premium-TV.git#main:warp
    image: omg-warp:latest
    container_name: omg-premium-tv-warp
    restart: unless-stopped
    environment:
      - WARP_LICENSE_KEY=${WARP_LICENSE_KEY:-}
    volumes:
      - omg-warp:/data

  omg-db:
    image: postgres:16-alpine
    container_name: omg-premium-tv-db
    restart: unless-stopped
    environment:
      - POSTGRES_USER=omg
      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-omg-premium-tv}
      - POSTGRES_DB=omg
    volumes:
      - omg-db:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U omg -d omg"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  omg-data:
  omg-db:
  omg-warp:
