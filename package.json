{
  "name": "omg-tv-stremio-addon",
  "version": "8.0.0",
  "description": "Un add-on per Stremio con playlist di canali M3U, multi-utente, con EPG centralizzato.",
  "main": "dist/index.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "start:tsx": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://omg:omg@localhost/omg_test} tsx --test test/*.test.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "sax": "^1.4.1"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/sax": "^1.2.7",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
